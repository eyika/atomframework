<?php

// Ensure error reporting is enabled
error_reporting(E_ALL);
ini_set('display_errors', '1');

// Load Composer autoload
require dirname(__DIR__) . '/../../../../autoload.php';

/*
|--------------------------------------------------------------------------
| Create The Application
|--------------------------------------------------------------------------
|
| The first thing we will do is create a new Atom application instance
| which serves as the "glue" for all the components of Atom, and is
| the IoC container for the system binding all of the various parts.
|
*/

use Eyika\Atom\Framework\Foundation\Application;

// Load Atom framework
$app = new Application(
    $_ENV['APP_BASE_PATH'] ?? strstr(dirname(__DIR__), '/vendor', true)
);
/** @var Eyika\Atom\Framework\Foundation\Contracts\ConsoleKernel $kernel */

/*
|--------------------------------------------------------------------------
| Bind Important Interfaces
|--------------------------------------------------------------------------
|
| Next, we need to bind some important interfaces into the container so
| we will be able to resolve them when needed. The kernels serve the
| incoming requests to this application from both the web and CLI.
|
*/

$app->singleton(
    Eyika\Atom\Framework\Foundation\Contracts\Kernel::class,
    App\Http\Kernel::class
);

$app->singleton(
    Eyika\Atom\Framework\Foundation\Contracts\ConsoleKernel::class,
    App\Console\Kernel::class
);

$app->singleton(
    Eyika\Atom\Framework\Foundation\Contracts\ExceptionHandler::class,
    App\Exceptions\Handler::class
);

// Set Facade application
Eyika\Atom\Framework\Support\Facade\Facade::setFacadeApplication($app);

// Boot application
// $app->boot();

return $app;
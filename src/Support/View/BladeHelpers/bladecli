<?php

namespace Eyika\Atom\Framework\Support\View\BladeHelpers;

use Eyika\Atom\Framework\Support\View\Blade;

// this code only runs on CLI but only if bladeonecli.php is called directly and via command line.

if (!defined('PHPUNIT_COMPOSER_INSTALL') && !defined('__PHPUNIT_PHAR__')
    && isset($_SERVER['PHP_SELF']) &&
    !http_response_code() &&
    (basename($_SERVER['PHP_SELF']) === 'bladecli.php' || basename($_SERVER['PHP_SELF']) === 'bladecli')
) {
    // we also excluded it if it is called by phpunit.
    include_once __DIR__ . '/../Blade.php';

    $compilepath = Blade::getParameterCli('compilepath', null);
    $templatepath = Blade::getParameterCli('templatepath', null);
    if (!Blade::isAbsolutePath($compilepath)) {
        $compilepath = getcwd() . '/' . $compilepath;
    }
    if (!Blade::isAbsolutePath($templatepath)) {
        $templatepath = getcwd() . '/' . $templatepath;
    }
    $inst = new Blade($templatepath, $compilepath);
    $inst->cliEngine();
} else {
    @http_response_code(404);
}
